{
  "name": "qingmo",
  "version": "1.2.0",
  "description": "轻墨 QingMo — 简洁轻量的跨平台 Markdown 编辑器",
  "main": "src/main/main.js",
  "author": "王君龙",
  "license": "MIT",
  "scripts": {
    "build:renderer": "node scripts/build-renderer.js",
    "start": "npm run build:renderer && electron .",
    "dev": "npm run build:renderer && electron .",
    "pack:win": "npm run build:renderer && electron-builder --win",
    "pack:mac": "npm run build:renderer && electron-builder --mac",
    "pack": "npm run build:renderer && electron-builder --win --mac",
    "pack:mac-x": "node scripts/mac/build-mac.js",
    "mac:fetch": "node scripts/mac/fetch-runtime.js",
    "cache:clean": "node scripts/clean-cache.js",
    "gen:icons": "node scripts/gen-icons.js && node scripts/make-ico.js"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.6.0",
    "@codemirror/lang-markdown": "^6.2.5",
    "@codemirror/language": "^6.10.2",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.5.6",
    "@codemirror/state": "^6.4.1",
    "@codemirror/view": "^6.28.0",
    "@lezer/highlight": "^1.2.0",
    "dompurify": "^3.1.5",
    "esbuild": "^0.28.2",
    "marked": "^14.0.0"
  },
  "build": {
    "appId": "cn.bajiaolu.qingmo",
    "productName": "轻墨",
    "directories": {
      "output": "build-output"
    },
    "files": [
      "src/main/**/*",
      "src/renderer/index.html",
      "src/renderer/style.css",
      "src/renderer/app.bundle.js",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icons/icon.ico"
    },
    "mac": {
      "target": [
        "zip"
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icons/icon.icns"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "轻墨",
      "installerLanguages": [
        "zh_CN"
      ],
      "language": "2052"
    },
    "extraResources": [
      {
        "from": "build/icons",
        "to": "icons",
        "filter": [
          "icon-256.png"
        ]
      }
    ]
  },
  "productName": "轻墨"
}